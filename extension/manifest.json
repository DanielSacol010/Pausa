{
  "manifest_version": 3,
  "name": "Pausa",
  "version": "0.1.1",
  "description": "Bloquea los sitios que distraen mientras tienes una sesión de enfoque abierta en Pausa.",
  "permissions": [
    "declarativeNetRequest",
    "storage",
    "alarms",
    "contentSettings"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://web-two-dun-16.vercel.app/*",
        "http://localhost:5173/*",
        "http://127.0.0.1:5173/*"
      ],
      "js": [
        "puente.js"
      ],
      "run_at": "document_start"
    }
  ],
  "action": {
    "default_title": "Pausa",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icono-16.png",
      "32": "icons/icono-32.png"
    }
  },
  "icons": {
    "16": "icons/icono-16.png",
    "48": "icons/icono-48.png",
    "128": "icons/icono-128.png"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "blocked.html"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
